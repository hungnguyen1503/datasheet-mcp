# ── MCP transport ─────────────────────────────────────────────────────────────
DS_TRANSPORT=streamable-http          # stdio | streamable-http | sse
DS_HOST=127.0.0.1
DS_PORT=8060

# ── Qdrant vector store (shared instance) ─────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Access control (optional) ─────────────────────────────────────────────────
DS_API_KEYS=
DS_SERVER_URL=https://datasheetmcp.hungnguyenjx.space

# ── Embedding model ───────────────────────────────────────────────────────────
DS_EMBED_MODEL=BAAI/bge-base-en-v1.5   # 768 dimensions
DS_EMBED_QUERY_PREFIX=Represent this sentence for searching relevant passages:
# DS_EMBED_DEVICE=cuda                  # cuda | cpu (auto-detected if unset)

# ── Optional cross-encoder reranker ──────────────────────────────────────────
DS_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Optional local-only semantic enrichment ─────────────────────────────────
# DS_LOCAL_AI_URL=http://127.0.0.1:1234/v1
# DS_LOCAL_AI_MODEL=qwen3-vl-8b
# DS_LOCAL_AI_ALLOW_LAN=0               # set 1 only for a trusted private-LAN host

# ── MinerU device (Stage 1 — auto-detected from CUDA availability) ────────────
# MINERU_DEVICE_MODE=cuda               # override: cuda | cpu

# ── Collection prefix (for nightly / multi-tenant) ────────────────────────────
# DS_COLLECTION_PREFIX=

# ── Console UTF-8 ─────────────────────────────────────────────────────────────
PYTHONUTF8=1
PYTHONIOENCODING=utf-8
