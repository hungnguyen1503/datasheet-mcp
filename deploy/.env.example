# Datasheet MCP server — deployment config
# =========================================
# Copy to mcp/.env and fill in the values.

# Server
DS_TRANSPORT=streamable-http
DS_HOST=127.0.0.1
DS_PORT=8060
DS_API_KEYS=your-bearer-token-here
DS_SERVER_URL=https://datasheetmcp.hungnguyenjx.space

# Qdrant (local on server)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=3f99b017871d4f908b955eb2637ef80846139bc6d9ef9824dfcf148683d93cf1

# Embedding
DS_EMBED_MODEL=BAAI/bge-small-en-v1.5
DS_EMBED_QUERY_PREFIX=Represent this sentence for searching relevant passages:
DS_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Python
PYTHONUTF8=1
PYTHONIOENCODING=utf-8

# Cloudflared tunnel token (used by deploy/docker-compose.yml)
TUNNEL_TOKEN=your-cloudflare-tunnel-token
